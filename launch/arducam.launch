<launch>
  <arg name="serial_no" default="$(optenv CAMERA1_SN)" />
  <arg name="device_path" default="$(eval '/dev/' + (('arducam_' + serial_no) if serial_no else 'video0'))" />
  <arg name="camera" default="camera1" />

  <group ns="$(arg camera)">
    <node pkg="cv_camera" type="cv_camera_node" name="color">
      <param name="rate" value="5.0" />
      <param name="device_path" value="$(arg device_path)" />
      <param name="frame_id" value="$(arg camera)_color_optical_frame" />
      <param name="camera_info_url" value="file:///$(find cv_camera)/param/arducam.yaml" />
      <param name="camera_name" value="arducam" />
    </node>
  </group>

</launch>
